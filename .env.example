# ==============================================================================
# APEXPCB SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# Rename this file to '.env' in production deployments.
# ==============================================================================

# Node.js API Gateway Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas URI)
# Copy the connection string from Atlas (Connect -> Drivers). Never commit the real value.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Microservices Communication
AI_SERVICE_URL=http://pcb_ai_service:8000

# Python Flask AI Service Configuration
FLASK_PORT=8000
FLASK_HOST=0.0.0.0
MODEL_PATH=runs/detect/train-4/weights/best.pt
